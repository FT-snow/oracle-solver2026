{
  "manifest_version": 3,
  "name": "Quiz Relay",
  "version": "1.0.0",
  "description": "Sends the current quiz question to the local relay and clicks the operator's answer.",
  "host_permissions": [
    "http://127.0.0.1:8787/*",
    "http://localhost:8787/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://academy.oracle.com/*",
        "https://*.oracle.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}