{
  "manifest_version": 3,
  "name": "Oracle Solver 2026",
  "version": "2.4.0",
  "description": "Autonomous Oracle Academy autopilot: solves quizzes from the shared cloud database, learns from feedback, auto-retakes to 100%. Login required — one device per account.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://sleek-oyster-317.convex.site/*",
    "http://127.0.0.1:8787/*",
    "http://localhost:8787/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Oracle Solver 2026"
  },
  "content_scripts": [
    {
      "matches": [
        "https://academy.oracle.com/*",
        "https://*.oracle.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
