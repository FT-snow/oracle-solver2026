  "version": "2.0.0",
  "description": "Oracle Academy quiz autopilot — Chrome extension + local relay + Gemini auto-solve + Convex cloud auth & shared answer database",
  "scripts": {
    "relay": "node relay.js",
    "auto": "node auto.js",
    "admin": "node admin.js",
