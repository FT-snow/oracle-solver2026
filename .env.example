# ── Google Gemini (AI auto-solve) ────────────────────────────────────────────
# Single key:
GEMINI_API_KEY=your_gemini_api_key_here
# Or multiple comma-separated keys for automatic rate-limit rotation:
# GEMINI_API_KEYS=key1,key2,key3

# ── Convex cloud (auth + shared answer database) ────────────────────────────
# HTTP actions URL of your Convex deployment (NOT the .convex.cloud one):
CONVEX_URL=https://sleek-lemur-918.convex.site
# Same secret you set with: npx convex env set ADMIN_SECRET <value>
# Used by admin.js / answers.js --cloud / seed script.
ADMIN_SECRET=replace-with-your-admin-secret

# ── Relay access control ─────────────────────────────────────────────────────
# Credentials auto.js uses to log in when the relay enforces access control.
# Create a DEDICATED CLI account (it gets bound to this machine):
#   node admin.js add-user prakhar-cli --role admin
AUTH_USER=prakhar-cli
AUTH_PASS=change-me

# Guess choice [1] when the AI cannot answer, so the quiz never stalls.
ALLOW_FALLBACK_GUESS=true

# ── Optional ─────────────────────────────────────────────────────────────────
# RELAY_PORT=8787
# AUTH_PORT=8788
